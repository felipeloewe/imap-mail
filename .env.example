# MySQL (required) — dedicated schema for this Node service
DATABASE_URL="mysql://repositoria:repositoria@127.0.0.1:3306/imap_mail"

# Local storage for attachments + thread certificate PDFs
ATTACHMENTS_DIR="./data/attachments"
CERTIFICATES_DIR="./data/certificates"

# Service port (Node/Next). CI4 Repositoria typically runs on :8080 (Apache/php).
PORT=3001
MAIL_SERVICE_PORT=3001

# --- Gmail OAuth (optional; never pass secrets on argv) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI="http://localhost:3001/api/oauth/gmail/callback"

# --- Outbound push → CodeIgniter 4 Repositoria Documentos ---
# CI4 route: POST /api/webhooks/imap-mail  (app/Controllers/Webhook.php)
# Example local CI4: http://localhost:8080/api/webhooks/imap-mail
# Example cPanel:    https://repositoria.tudominio.cl/api/webhooks/imap-mail
REPOSITORIA_WEBHOOK_URL=
# Shared with CI4 env REPOSITORIA_WEBHOOK_SECRET (header X-Repositoria-Secret)
REPOSITORIA_WEBHOOK_SECRET=
