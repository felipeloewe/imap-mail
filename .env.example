# MySQL (required)
DATABASE_URL="mysql://repositoria:repositoria@127.0.0.1:3306/imap_mail"

# Local storage for attachments + thread certificate PDFs
ATTACHMENTS_DIR="./data/attachments"
CERTIFICATES_DIR="./data/certificates"

# Service port (Next.js). Repositoria typically runs on 3000.
PORT=3001
MAIL_SERVICE_PORT=3001

# --- Gmail OAuth (optional; never pass secrets on argv) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI="http://localhost:3001/api/oauth/gmail/callback"

# --- Outbound push into Repositoria document repo (stub) ---
# Repositoria will expose an ingest endpoint; this service POSTs adjuntos + certificado PDF.
REPOSITORIA_WEBHOOK_URL=
REPOSITORIA_WEBHOOK_SECRET=
